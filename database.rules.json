{
  "rules": {
    "L": {
      ".read": true,
      "$roomId": {
        // Создавать лобби может кто угодно (клиент пишет целиком объект при создании)
        ".write": "auth === null && (!data.exists() || newData.exists())",
        "n":  { ".validate": "newData.isString() && newData.val().length < 40" },
        "pa": { ".validate": "newData.isBoolean()" },
        "mx": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8" },
        "h":  { ".validate": "newData.isString()" },
        "g":  { ".validate": "newData.isString()" },
        "s":  { ".validate": "newData.isString()" },
        "t":  { ".validate": "newData.isNumber()" },
        "cm": { ".validate": "newData.isString()" },
        "mn": { ".validate": "newData.isString()" },
        "mid":{ ".validate": "newData.isString()" },
        "df": { ".validate": "newData.isString()" },
        "ft": { ".validate": "newData.isNumber()" },
        "seed":{ ".validate": "newData.isNumber()" },
        "Kc": { ".validate": "newData.isNumber()" },
        "rp": { ".validate": "newData.isNumber()" },
        "w":  { ".validate": "newData.isString()" },
        "v":  { ".validate": "newData.val() === null || newData.hasChildren()" },
        "pv": { ".validate": "newData.val() === null || newData.hasChildren()" },
        "E": {
          "a": { ".validate": "newData.isBoolean()" },
          "x": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" }
        },
        "M": {
          "x": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "dx":{ ".validate": "newData.isNumber()" },
          "dz":{ ".validate": "newData.isNumber()" }
        },
        "tp": {
          "a": { ".validate": "newData.isBoolean()" },
          "s": { ".validate": "newData.isNumber()" }
        },
        "tp_req": { ".validate": "newData.val() === null || (newData.hasChildren(['u','t']))" },
        "K": {
          "$keyIdx": {
            "x": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "a": { ".validate": "newData.isBoolean()" }
          }
        },
        "P": {
          "$uid": {
            // писать в свою ветку может кто угодно (нет auth — это демо), но только существующим игрокам;
            // хост (h) может писать всем (чтобы ставить d=true при укусах и раскидывать по позициям при старте)
            ".write": "auth === null && (newData.exists() || data.exists())",
            "n": { ".validate": "newData.isString() && newData.val().length < 20" },
            "x": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "r": { ".validate": "newData.isBoolean()" },
            "d": { ".validate": "newData.isBoolean()" },
            "m": { ".validate": "newData.isBoolean()" },
            "c": { ".validate": "newData.isNumber()" },
            "ts":{ ".validate": "newData.val() === null || newData.isNumber()" }
          }
        }
      }
    },
    // Очистка старых лобби через onDisconnect — работает потому что клиент удаляет себя из /P/<uid>
    ".read": false,
    ".write": false
  }
}
